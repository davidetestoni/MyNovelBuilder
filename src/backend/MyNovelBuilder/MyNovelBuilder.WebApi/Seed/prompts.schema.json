{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidetestoni/MyNovelBuilder/blob/main/src/backend/MyNovelBuilder/MyNovelBuilder.WebApi/Seed/prompts.schema.json",
  "title": "MyNovelBuilder prompt seed fixture",
  "type": "object",
  "required": ["schemaVersion", "prompts"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "prompts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prompt"
      }
    }
  },
  "$defs": {
    "prompt": {
      "type": "object",
      "required": ["seedKey", "seedVersion", "name", "type", "messages"],
      "additionalProperties": false,
      "properties": {
        "seedKey": {
          "type": "string",
          "minLength": 1
        },
        "seedVersion": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "type": {
          "enum": [
            "generateText",
            "summarizeText",
            "replaceText",
            "createCompendiumRecord",
            "editCompendiumRecord",
            "sendChatMessage",
            "describeCompendiumImage",
            "createCompendiumRecordImageGenerationPrompt",
            "createStoryEvents",
            "translateNovel",
            "describeImage",
            "prepareImmersiveTts",
            "suggestStoryDevelopments",
            "worldBuildingAgent"
          ]
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/message"
          }
        }
      }
    },
    "message": {
      "type": "object",
      "required": ["role", "message"],
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": ["system", "user", "assistant"]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        }
      }
    }
  }
}
